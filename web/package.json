{
  "name": "nextcryptojob-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "npm run cf-typegen",
    "prebuild": "npm run cf-typegen && node scripts/legal-content.mjs && node scripts/api-docs.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.55.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@solana/kit": "8.3.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/svm": "2.25.0",
    "agents": "0.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.2",
    "tldts": "7.4.12",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
