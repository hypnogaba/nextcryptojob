{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nextcryptojob",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextcryptojob",
      "database_id": "c66a99cf-230b-4b8b-9cff-862d4b18a4ae"
    },
    {
      // База вакансій NextRole. Код лише читає з неї (docs/contracts.md, розділ 6).
      "binding": "JOBS_DB",
      "database_name": "crypto-jobs-agent",
      "database_id": "0bf4b998-cbdc-474b-b739-eb6e6e7d5a9d"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextcryptojob"
    }
  ],
  // Ліміти сплесків CRM і API (специфікація CRM, розділи 7.1 і 9). Лічильник
  // локальний для локації й приблизний, тому він лише від сплесків; денні
  // квоти рахує D1 (src/lib/crm/quotas.ts). namespace_id унікальні на акаунт.
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  "ratelimits": [
    // 60 запитів на хвилину на ключ API.
    { "name": "RL_API", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    // 120 запитів на хвилину на сесію члена команди.
    { "name": "RL_WEB", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    // 10 запитів на хвилину з однієї IP для гостей x402.
    { "name": "RL_IP", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } }
  ],
  // Власний домен: зона nextcryptojob.xyz active на Cloudflare з 12.09.
  // workers_dev поки лишаємо: на ньому вебхук бота й адреси входу Telegram.
  // Коли вони переїдуть на nextcryptojob.xyz, workers_dev варто вимкнути (як у
  // NextRole), щоб правила WAF зони не можна було обійти другою адресою.
  "routes": [{ "pattern": "nextcryptojob.xyz", "custom_domain": true }],
  "workers_dev": true,
  // Пошта для кодів входу: Cloudflare Email Service (бета, тариф Workers Paid).
  // Домен nextcryptojob.xyz підключено 12.09 (API email/sending/subdomains):
  // записи MX і SPF на cf-bounce, DKIM cf-bounce._domainkey, DMARC на _dmarc.
  // Без цього блоку у продакшені вхід поштою каже «Email sign-in opens soon.»,
  // а в `next dev` код пишеться в журнал (src/lib/mail/log.ts).
  // Адреси ті самі, що MAIL_FROM (коди входу) і DIGEST_FROM (добірка) у src/lib/mail/cloudflare.ts.
  // Документація: https://developers.cloudflare.com/email-service/configuration/send-bindings/
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["login@nextcryptojob.xyz", "jobs@nextcryptojob.xyz"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
