{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "nextcryptojob",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nextcryptojob",
      "database_id": "c66a99cf-230b-4b8b-9cff-862d4b18a4ae"
    },
    {
      // База вакансій NextRole. Код лише читає з неї (docs/contracts.md, розділ 6).
      "binding": "JOBS_DB",
      "database_name": "crypto-jobs-agent",
      "database_id": "0bf4b998-cbdc-474b-b739-eb6e6e7d5a9d"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextcryptojob"
    }
  ],
  // Власного домену ще немає: NS зони nextcryptojob.xyz чекають на Cloudflare.
  // До того сайт живе лише на workers.dev. Коли зона стане active, тут
  // з'являться routes з custom_domain, а workers_dev варто вимкнути (як у
  // NextRole), щоб правила WAF зони не можна було обійти другою адресою.
  "workers_dev": true,
  // Пошта для кодів входу: Cloudflare Email Service (бета, тариф Workers Paid).
  // ВИМКНЕНО: домен nextcryptojob.xyz ще не підключено до Email Service, а
  // відправник мусить бути на підключеному домені (інакше E_SENDER_NOT_VERIFIED).
  // Поки блоку немає, у продакшені вхід поштою каже «Email sign-in opens soon.»,
  // а в `next dev` код пишеться в журнал (src/lib/mail/log.ts).
  // Щоб увімкнути:
  //   1. Зона nextcryptojob.xyz active на Cloudflare (NS у Porkbun міняє власник).
  //   2. Dashboard → Email Service → Onboard domain: nextcryptojob.xyz, дочекатися
  //      записів SPF, DKIM і DMARC.
  //   3. Розкоментувати блок нижче й задеплоїти. Код сам побачить env.EMAIL.
  // Адреса та сама, що MAIL_FROM у src/lib/mail/cloudflare.ts.
  // Документація: https://developers.cloudflare.com/email-service/configuration/send-bindings/
  // "send_email": [
  //   {
  //     "name": "EMAIL",
  //     "allowed_sender_addresses": ["login@nextcryptojob.xyz"]
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
