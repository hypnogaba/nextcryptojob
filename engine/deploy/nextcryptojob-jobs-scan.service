[Unit]
Description=NextCryptoJob engine: daily crypto job scan into the jobs DB (jobs-scan)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nextcryptojob
Group=nextcryptojob
WorkingDirectory=/opt/nextcryptojob-engine
EnvironmentFile=/etc/nextcryptojob-engine.env
Environment=NODE_ENV=production
# Node 24 (engines >=24): на VPS /usr/bin/node це Node 22, Node 24 стоїть у /usr/local/bin.
ExecStart=/usr/local/bin/node dist/cli.js jobs-scan
# Близько 330 дошок ATS, три дошки й speedrun: хвилини; стеля з запасом на повільні джерела й 429.
TimeoutStartSec=3600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
