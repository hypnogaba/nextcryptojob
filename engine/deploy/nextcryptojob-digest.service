[Unit]
Description=NextCryptoJob engine: daily job digests for people whose hour it is (digest-due)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nextcryptojob
Group=nextcryptojob
WorkingDirectory=/opt/nextcryptojob-engine
EnvironmentFile=/etc/nextcryptojob-engine.env
Environment=NODE_ENV=production
# Node 24 (engines >=24): на VPS /usr/bin/node це Node 22, Node 24 стоїть у /usr/local/bin.
ExecStart=/usr/local/bin/node dist/cli.js digest-due
# Пул NextRole (~1 с) і по людині: запис, Telegram (429 чекає до 60 с), статуси.
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
